#include <iostream>
using namespace std;

int main() {
    int a, b;

    cout << "Enter first number: ";
    cin >> a;

    cout << "Enter second number: ";
    cin >> b;

    try {
        if (b == 0) {
            throw b;
        }

        cout << "Result = " << a / b << endl;
    }
    catch (int) {
        cout << "Error: Cannot divide by zero." << endl;
    }

    cout << "Program continues normally." << endl;

    return 0;
}
